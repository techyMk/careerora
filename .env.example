# ─── Database (Neon Postgres) ────────────────────────────────
# Get both URLs from your Neon dashboard → Connection details:
#   - "Pooled connection" → DATABASE_URL  (used at runtime by serverless functions)
#   - "Direct connection" → DIRECT_URL    (used by Prisma for migrations / db push)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js (NextAuth v5) ───────────────────────────────────
# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production-please-use-a-strong-random-string"

# Local dev only — on Vercel use the production URL or leave unset
AUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────
# Leave blank to disable the "Continue with Google" button.
# https://console.cloud.google.com/apis/credentials
#   - Authorized JavaScript origins: http://localhost:3000  + your prod URL
#   - Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google + prod equivalent
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Groq (optional) ─────────────────────────────────────────
# Without this, mock streaming is used. Free key at https://console.groq.com
GROQ_API_KEY=""

# ─── Stripe (optional — paid plans) ──────────────────────────
# Without these, the "Upgrade to Pro" buttons stay disabled and the Billing
# tab shows a "Payments not configured" notice. Set up:
#   1. https://dashboard.stripe.com/test/apikeys → copy secret + publishable
#   2. https://dashboard.stripe.com/test/products → create 3 products,
#      copy each recurring price id (price_xxx)
#   3. https://dashboard.stripe.com/test/webhooks → add endpoint
#      <your-url>/api/stripe/webhook, copy signing secret (whsec_xxx)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs (recurring). Find each on the product page in the dashboard.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_TEAMS_MONTHLY=""

# ─── Resend (optional — transactional email) ─────────────────
# Without this, emails are logged to the server console. Welcome
# email and password reset still work; the reset link is logged.
# https://resend.com/api-keys
RESEND_API_KEY=""
# Must be a verified sender on your Resend domain. Gmail addresses
# CANNOT be used here. Resend's sandbox sender works for testing:
EMAIL_FROM="Careerora <onboarding@resend.dev>"
# Replies to outbound emails go here — your real inbox is fine.
EMAIL_REPLY_TO="techymk.dev@gmail.com"

# ─── Vercel Domains API (optional — custom-domain auto-binding) ──
# Without these, users can still claim a custom domain in the portfolio
# editor, but you'll need to add the domain to your Vercel project manually.
# Create a token at https://vercel.com/account/tokens
# Find your project id at https://vercel.com/{org}/{project}/settings (URL slug)
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID="" # only if your project lives under a Vercel Team
