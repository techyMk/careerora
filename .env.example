# ─── Database ────────────────────────────────────────────────
# SQLite by default (file in project root). Swap for Postgres
# by changing the provider in prisma/schema.prisma too.
DATABASE_URL="file:./dev.db"

# ─── Auth.js (NextAuth v5) ───────────────────────────────────
# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production-please-use-a-strong-random-string"
AUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────
# Leave blank to disable the "Continue with Google" button.
# Get credentials at https://console.cloud.google.com/apis/credentials
#   - Authorized JavaScript origins: http://localhost:3000
#   - Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Groq (optional) ─────────────────────────────────────────
# Without this, mock streaming is used. Free key at https://console.groq.com
GROQ_API_KEY=""
